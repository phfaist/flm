{
  "feature": "html",
  "keys": [
    {
      "name": "title",
      "bind": "render",
      "default": "FLM document",
      "schema": {
        "type": "string",
        "default": "FLM document",
        "x-flm-bind": "render"
      }
    },
    {
      "name": "lang",
      "bind": "render",
      "default": null,
      "schema": {
        "type": [
          "string",
          "null"
        ],
        "default": null,
        "x-flm-bind": "render"
      }
    },
    {
      "name": "source_spans",
      "bind": "render",
      "default": false,
      "schema": {
        "type": "boolean",
        "default": false,
        "x-flm-bind": "render"
      }
    },
    {
      "name": "run_in_stop",
      "bind": "render",
      "marks": [
        "markup"
      ],
      "default": ".",
      "schema": {
        "type": "string",
        "default": ".",
        "x-flm-bind": "render",
        "x-flm-marks": [
          "markup"
        ]
      }
    },
    {
      "name": "definitions",
      "bind": "render",
      "schema": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/$defs/DefinitionOverride"
        },
        "x-flm-bind": "render"
      }
    },
    {
      "name": "required_definitions",
      "bind": "render",
      "default": [],
      "schema": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string"
        },
        "default": [],
        "x-flm-bind": "render"
      }
    },
    {
      "name": "heading_tags",
      "bind": "render",
      "default": {},
      "schema": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        },
        "default": {},
        "x-flm-bind": "render"
      }
    },
    {
      "name": "root_heading_level",
      "bind": "render",
      "default": 1,
      "schema": {
        "type": "integer",
        "format": "uint8",
        "minimum": 0,
        "maximum": 255,
        "default": 1,
        "x-flm-bind": "render"
      }
    }
  ],
  "definitions": {
    "HtmlRenderOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "default": "FLM document"
        },
        "lang": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "source_spans": {
          "type": "boolean",
          "default": false
        },
        "run_in_stop": {
          "type": "string",
          "default": "."
        },
        "definitions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/DefinitionOverride"
          }
        },
        "required_definitions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "default": []
        },
        "heading_tags": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "root_heading_level": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255,
          "default": 1
        }
      }
    },
    "DefinitionOverride": {
      "oneOf": [
        {
          "type": "string",
          "const": "provided-by-host"
        },
        {
          "type": "object",
          "properties": {
            "parts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/DefContent"
              }
            }
          },
          "required": [
            "parts"
          ],
          "additionalProperties": false
        }
      ]
    },
    "DefContent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "inline": {
              "type": "string"
            }
          },
          "required": [
            "inline"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "file": {
              "type": "string"
            }
          },
          "required": [
            "file"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
