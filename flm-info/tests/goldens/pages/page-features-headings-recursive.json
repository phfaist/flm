        "namespace": "lowering-rule",
        "entries": [
          {
            "name": "flm.heading.number.lower.default",
            "owner": "headings",
            "summary": "a heading's number lowers to `flm.pres.span` of role `flm.heading.number` around the number"
          },
          {
            "name": "flm.heading.lower.default",
            "owner": "headings",
            "summary": "a heading lowers to `flm.pres.block-heading` carrying its kind's name and level, whether it is listed in a table of contents, and its anchor, or, for a run-in kind, to a `flm.pres.deco.runin` decoration holding a `flm.pres.runin-heading` with the same payload; a numbered heading's content begins with its number"
          },
          {
            "name": "flm.heading.lower.latex-recomposed",
            "owner": "headings",
            "summary": "a heading lowers to the LaTeX hook `\\flmHeading[toc=…]` (with `alt={…}` where the heading has an alternative title), a newline, the LaTeX sectioning command its heading kind maps to, starred when not numbered, and a group holding the labels it read from its `\\label` fields"
          },
          {
            "name": "flm.heading.number.lower.latex-recomposed",
            "owner": "headings",
            "summary": "a heading's number lowers to its content; the heading itself is written back as its sectioning command, so the number never reaches this backend"
          }
        ]
